{
  "expo": {
    "name": "Rena Pro",
    "slug": "rena-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "renapro",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16296b"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.renacleaning.pro",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Rena Pro uses Face ID to keep your account and jobs secure."
      }
    },
    "android": {
      "package": "uk.co.renacleaning.pro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16296b"
      }
    },
    "plugins": ["expo-secure-store", "expo-local-authentication"],
    "extra": {
      "baseUrl": "https://www.renacleaning.co.uk",
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
