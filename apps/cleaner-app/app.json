{
  "expo": {
    "name": "Rena Cleaner",
    "slug": "rena-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rena-cleaner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rena.cleaner",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Rena Cleaner to access your camera for arrival photos and evidence uploads.",
        "NSPhotoLibraryUsageDescription": "Allow Rena Cleaner to access your photos to upload images.",
        "NSLocationWhenInUseUsageDescription": "Allow Rena Cleaner to access your location for navigation to jobs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "package": "com.rena.cleaner",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-font", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id-cleaner"
      }
    }
  }
}
