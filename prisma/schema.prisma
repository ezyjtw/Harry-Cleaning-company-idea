generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  CLEANER
  ADMIN
}

enum CleanerTier {
  STARTER
  BRONZE
  SILVER
  GOLD
  ELITE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  REVIEWED
  CANCELLED
  DISPUTED
}

enum PricingModel {
  HOURLY
  FIXED
}

enum PropertySize {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_BED
  FIVE_PLUS
}

enum BookingFrequency {
  WEEKLY
  FORTNIGHTLY
  ONE_OFF
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CleanerQueueStatus {
  PENDING    // Waiting for cleaner response
  ACCEPTED   // Cleaner accepted the job
  REJECTED   // Cleaner declined
  EXPIRED    // Timed out without response
  SUPERSEDED // Another cleaner accepted first
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_SENT
  NEW_MESSAGE
  NEW_REVIEW
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  ACCOUNT_UPDATE
  SYSTEM
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ReviewVisibility {
  VISIBLE
  HIDDEN
  FLAGGED
}

enum ProviderType {
  INDIVIDUAL
  COMPANY
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum TeamMemberRole {
  OWNER
  MANAGER
  CLEANER
}

enum ComplaintCategory {
  NO_SHOW
  POOR_QUALITY
  PROPERTY_DAMAGE
  INCORRECT_DURATION
  SAFETY_CONCERN
  PAYMENT_ISSUE
  UNPROFESSIONAL
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  PHOTO
  VIDEO
  TEXT
  DOCUMENT
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String?
  name             String?
  phone            String?
  role             Role          @default(CLIENT)
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  accountStatus    AccountStatus @default(ACTIVE)
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?
  failedLoginCount Int           @default(0)
  isSuspended      Boolean       @default(false)
  lockedUntil      DateTime?

  accounts          Account[]
  sessions          Session[]
  cleanerProfile    CleanerProfile?
  addresses         Address[]
  bookingsAsClient  Booking[]       @relation("ClientBookings")
  bookingsAsCleaner Booking[]       @relation("CleanerBookings")
  reviewsGiven      Review[]        @relation("ReviewsGiven")
  reviewsReceived   Review[]        @relation("ReviewsReceived")
  sentMessages      Message[]       @relation("SentMessages")
  receivedMessages  Message[]       @relation("ReceivedMessages")
  notifications     Notification[]
  disputesRaised    Dispute[]       @relation("DisputesRaised")
  ownedCompany      Company?        @relation("CompanyOwner")
  teamMemberships   TeamMember[]
  complaints        Complaint[]     @relation("ComplaintsFiled")
  cleanerQueueEntries BookingCleanerQueue[] @relation("CleanerQueueEntries")
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([role])
}

model CleanerProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  bio                   String?            @db.Text
  hourlyRate            Decimal            @default(15.00) @db.Decimal(10, 2)
  specialties           String[]
  tier                  CleanerTier        @default(STARTER)
  verified              Boolean            @default(false)
  documentsUploaded     Boolean            @default(false)
  backgroundCheckPassed Boolean            @default(false)

  // DBS certificate — destroyed after verification, only metadata retained
  dbsCertVerified       Boolean            @default(false)
  dbsCertNumber         String?            // retained after destruction
  dbsCertIssueDate      DateTime?          // retained after destruction
  dbsCertDestroyedAt    DateTime?          // when the actual file was destroyed
  location              String?
  latitude              Float?
  longitude             Float?
  radius                Int                @default(10) // miles
  availableNow          Boolean            @default(false)
  responseTime          Int? // average response time in minutes
  completedJobs         Int                @default(0)
  rating                Decimal            @default(0) @db.Decimal(3, 2)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  serviceRadius         Int                @default(10)
  travelFee             Decimal            @default(0) @db.Decimal(10, 2)
  cancellationRate      Decimal            @default(0) @db.Decimal(5, 2)
  completionRate        Decimal            @default(100) @db.Decimal(5, 2)
  responseSpeed         Int? // average response speed in seconds
  postcode              String?
  ryftAccountId         String?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  identityVerifiedAt    DateTime?
  verificationMeta      Json?
  totalJobsCompleted    Int                @default(0)
  availabilitySummary   String?            @db.Text

  // Right to work verification
  rightToWorkStatus     VerificationStatus @default(UNVERIFIED)
  rightToWorkDocType    String?            // "uk_passport", "brp", "eu_settled", "eu_pre_settled", "share_code", "visa"
  rightToWorkDocFile    String?            // stored file reference
  rightToWorkShareCode  String?            // gov.uk share code if applicable
  rightToWorkExpiresAt  DateTime?          // null for indefinite right (UK/Irish citizens)
  rightToWorkVerifiedAt DateTime?

  providerId            String?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              Provider?              @relation(fields: [providerId], references: [id])
  availabilitySlots     AvailabilitySlot[]
  availabilityOverrides AvailabilityOverride[]

  @@index([userId])
  @@index([tier])
  @@index([verified])
  @@index([availableNow])
  @@index([location])
  @@index([rating])
  @@index([providerId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String? // e.g. "Home", "Office"
  line1     String
  line2     String?
  city      String
  postcode  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@index([postcode])
}

model Booking {
  id                 String        @id @default(cuid())
  clientId           String?
  cleanerId          String
  addressId          String?
  guestEmail         String?
  guestName          String?
  guestPhone         String?
  guestToken         String?       @unique
  serviceType        String // e.g. "standard", "deep", "end-of-tenancy", "move-in"
  status             BookingStatus @default(PENDING)
  date               DateTime
  startTime          String // e.g. "09:00"
  duration           Decimal       @db.Decimal(4, 2) // hours
  rooms              Json? // { "bedrooms": 2, "bathrooms": 1, "kitchen": true, ... }
  extras             String[] // e.g. ["oven", "fridge", "windows"]
  frequency          String? // e.g. "one-off", "weekly", "fortnightly", "monthly"
  totalPrice         Decimal       @db.Decimal(10, 2)
  platformFee        Decimal       @db.Decimal(10, 2)
  cleanerEarnings    Decimal       @db.Decimal(10, 2)
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  acceptedAt         DateTime?
  checkedInAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text
  cleanerNotes       String?       @db.Text
  adminNotes         String?       @db.Text
  checklistCompleted Boolean       @default(false)
  arrivalConfirmed   Boolean       @default(false)

  providerId         String?

  client   User?     @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  cleaner  User      @relation("CleanerBookings", fields: [cleanerId], references: [id], onDelete: Cascade)
  address  Address?  @relation(fields: [addressId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])
  review   Review?
  messages Message[]
  payment  Payment?
  dispute  Dispute?
  complaints    Complaint[]
  bookingAddons BookingAddon[]
  cleanerQueue  BookingCleanerQueue[]

  // ─── Pricing snapshot (captured at booking creation) ─────
  cleanerHourlyRate    Float?             // cleaner's standard rate at booking time
  cleanerDeepRate      Float?             // derived deep rate (standard * 1.45) — set for EOT/Airbnb
  propertySize         PropertySize?      // for EOT/Airbnb
  bookingFrequency     BookingFrequency?  // WEEKLY | FORTNIGHTLY | ONE_OFF
  serviceMultiplier    Float?             // multiplier applied
  cleanerGross         Float?             // rate * hours * multiplier
  cleanerFee           Float?             // 10% deducted from cleaner
  cleanerEarns         Float?             // cleanerGross * 0.90
  customerSubtotal     Float?             // = cleanerGross (or fixed price before customer fee)
  customerServiceFee   Float?             // 6% added on top for customer (hourly) or embedded (fixed)
  addonTotal           Float?             @default(0)
  renaEarns            Float?             // cleanerFee + customerServiceFee

  // ─── Top 3 Queue & Escrow ─────
  isQueuedBooking      Boolean            @default(false)
  escrowAmount         Float?             // max quote held in escrow (most expensive of top 3)
  escrowRefundAmount   Float?             // difference refunded after cleaner accepts
  acceptedFromQueue    Boolean            @default(false)

  @@index([clientId])
  @@index([cleanerId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
  @@index([cleanerId, date])
  @@index([providerId])
  @@index([guestToken])
}

model Review {
  id                String           @id @default(cuid())
  bookingId         String           @unique
  clientId          String
  cleanerId         String
  rating            Decimal          @db.Decimal(2, 1) // 1.0 - 5.0
  thoroughness      Decimal?         @db.Decimal(2, 1)
  punctuality       Decimal?         @db.Decimal(2, 1)
  communication     Decimal?         @db.Decimal(2, 1)
  text              String?          @db.Text
  reply             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isModerated       Boolean          @default(false)
  visibility        ReviewVisibility @default(VISIBLE)
  isVerifiedBooking Boolean          @default(true)
  isDisputed        Boolean          @default(false)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client  User    @relation("ReviewsGiven", fields: [clientId], references: [id], onDelete: Cascade)
  cleaner User    @relation("ReviewsReceived", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([cleanerId])
  @@index([rating])
  @@index([visibility])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  bookingId  String?
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([bookingId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  ryftPaymentId   String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  refundAmount    Decimal?      @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([ryftPaymentId])
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  raisedById  String
  reason      String
  description String        @db.Text
  status      DisputeStatus @default(OPEN)
  resolution  String?       @db.Text
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime      @updatedAt

  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy User             @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  evidence DisputeEvidence[]

  @@index([bookingId])
  @@index([raisedById])
  @@index([status])
}

model AvailabilitySlot {
  id               String @id @default(cuid())
  cleanerProfileId String
  dayOfWeek        Int // 0 = Sunday, 6 = Saturday
  startTime        String // e.g. "09:00"
  endTime          String // e.g. "17:00"

  cleanerProfile CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@index([cleanerProfileId])
  @@index([dayOfWeek])
}

model AvailabilityOverride {
  id               String   @id @default(cuid())
  cleanerProfileId String
  date             DateTime @db.Date
  isBlocked        Boolean  @default(true)
  startTime        String? // if partial day, e.g. "09:00"
  endTime          String? // if partial day, e.g. "13:00"
  reason           String? // e.g. "Holiday", "Personal"
  createdAt        DateTime @default(now())

  cleanerProfile CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@unique([cleanerProfileId, date])
  @@index([cleanerProfileId])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g. "BOOKING_CREATED", "PAYMENT_PROCESSED"
  entityType String // e.g. "Booking", "Payment", "User"
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model PricingRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  multiplier  Decimal   @default(1.0) @db.Decimal(5, 2)
  isActive    Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model PricingZone {
  id             String  @id @default(cuid())
  name           String // e.g. "Central London", "Greater London"
  postcodePrefix String  @unique // e.g. "SW1", "E1"
  multiplier     Decimal @default(1.0) @db.Decimal(4, 2)
  travelFee      Decimal @default(0) @db.Decimal(10, 2)
  isActive       Boolean @default(true)

  @@index([postcodePrefix])
  @@index([isActive])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        String // e.g. "SEND_EMAIL", "PROCESS_PAYMENT", "SEND_REMINDER"
  payload     Json
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([type])
  @@index([scheduledAt])
}

// ─── Provider System ─────────────────────────────────────────────────────────

model Provider {
  id        String       @id @default(cuid())
  type      ProviderType @default(INDIVIDUAL)
  companyId String?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company  Company?         @relation(fields: [companyId], references: [id])
  cleaners CleanerProfile[]
  bookings Booking[]

  @@index([type])
  @@index([companyId])
}

model Company {
  id                 String                    @id @default(cuid())
  ownerId            String                    @unique
  name               String
  description        String?                   @db.Text
  logo               String?
  website            String?
  phone              String?
  email              String?
  registrationNumber String?
  verificationStatus CompanyVerificationStatus  @default(PENDING)
  staffCount         Int                        @default(1)
  operatingAreas     String[]
  specialties        String[]
  insuranceVerified  Boolean                    @default(false)
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  owner    User         @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  provider Provider?
  team     TeamMember[]

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([isActive])
}

model TeamMember {
  id          String         @id @default(cuid())
  companyId   String
  userId      String
  role        TeamMemberRole @default(CLEANER)
  isActive    Boolean        @default(true)
  canAcceptJobs Boolean      @default(false)
  joinedAt    DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([isActive])
}

// ─── Complaint & Evidence System ─────────────────────────────────────────────

model Complaint {
  id          String            @id @default(cuid())
  bookingId   String
  filedById   String
  category    ComplaintCategory
  severity    ComplaintSeverity @default(MEDIUM)
  subject     String
  description String            @db.Text
  status      DisputeStatus     @default(OPEN)
  resolution  String?           @db.Text
  refundAmount Decimal?         @db.Decimal(10, 2)
  isRedoClean Boolean           @default(false)
  createdAt   DateTime          @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime          @updatedAt

  booking  Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  filedBy  User                @relation("ComplaintsFiled", fields: [filedById], references: [id], onDelete: Cascade)
  evidence ComplaintEvidence[]

  @@index([bookingId])
  @@index([filedById])
  @@index([status])
  @@index([category])
  @@index([severity])
}


model ComplaintEvidence {
  id          String       @id @default(cuid())
  complaintId String
  type        EvidenceType
  url         String
  fileName    String?
  description String?      @db.Text
  uploadedAt  DateTime     @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model DisputeEvidence {
  id         String       @id @default(cuid())
  disputeId  String
  type       EvidenceType
  url        String
  fileName   String?
  description String?     @db.Text
  uploadedBy String // userId
  uploadedAt DateTime     @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([uploadedBy])
}

// ─── Pricing Engine ─────────────────────────────────────────────────────────

model ServiceType {
  id             String       @id @default(cuid())
  slug           String       @unique // "regular", "one-off", "same-day", "deep", "eot", "airbnb"
  name           String
  pricingModel   PricingModel // HOURLY | FIXED
  baseMultiplier Float        // 1.0 for regular, 1.15 for one-off, etc
  minimumHours   Float?       // null for fixed-price services
  minimumCharge  Float?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  fixedPrices FixedServicePrice[]
  addons      ServiceAddon[]
}

model FixedServicePrice {
  id            String       @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType  @relation(fields: [serviceTypeId], references: [id])
  propertySize  PropertySize // STUDIO | ONE_BED | TWO_BED | THREE_BED | FOUR_BED | FIVE_PLUS
  estimatedHours Float
  customerPrice Float        // what customer pays (incl. platform fee)
  createdAt     DateTime     @default(now())

  @@unique([serviceTypeId, propertySize])
}

model ServiceAddon {
  id            String      @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  name          String
  price         Float
  isActive      Boolean     @default(true)

  bookingAddons BookingAddon[]
}

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model BookingAddon {
  id        String       @id @default(cuid())
  bookingId String
  booking   Booking      @relation(fields: [bookingId], references: [id])
  addonId   String
  addon     ServiceAddon @relation(fields: [addonId], references: [id])
  price     Float        // snapshot price at time of booking

  @@unique([bookingId, addonId])
}

// ─── Top 3 Cleaner Queue ────────────────────────────────────────────────────

model BookingCleanerQueue {
  id              String             @id @default(cuid())
  bookingId       String
  cleanerId       String             // userId of the cleaner
  rank            Int                // 1 = best match, 2 = second, 3 = third
  status          CleanerQueueStatus @default(PENDING)
  quotedTotal     Float              // total customer would pay with this cleaner
  cleanerEarns    Float              // what the cleaner nets after fees
  matchScore      Float              // score from matching algorithm
  notifiedAt      DateTime?          // when the cleaner was notified
  respondedAt     DateTime?          // when they accepted/rejected
  expiresAt       DateTime?          // auto-expire deadline
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleaner User    @relation("CleanerQueueEntries", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, cleanerId])
  @@index([bookingId])
  @@index([cleanerId])
  @@index([status])
}

// ─── Abandoned Lead Tracking ─────────────────────────────────────────────────

model AbandonedLead {
  id          String    @id @default(cuid())
  email       String
  cleanerId   String?
  postcode    String?
  step        Int       @default(1)
  emailSent   Boolean   @default(false)
  lastEmailAt DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([emailSent])
  @@index([createdAt])
}

// ─── Analytics Event Tracking ───────────────────────────────────────────────

model AnalyticsEvent {
  id           String   @id @default(cuid())
  sessionId    String   // anonymous session identifier
  userId       String?  // null for unauthenticated visitors
  eventType    String   // e.g. "FUNNEL_STEP", "PAGE_VIEW", "FORM_INTERACTION", "DROP_OFF"
  funnel       String?  // e.g. "booking", "cleaner_signup", "client_signup"
  funnelStep   Int?     // step number in funnel (1, 2, 3...)
  stepName     String?  // e.g. "postcode_entered", "service_selected", "payment_submitted"
  page         String?  // URL path
  referrer     String?  // where they came from
  metadata     Json?    // flexible extra data (form field, error message, time on step, etc.)
  deviceType   String?  // "mobile", "tablet", "desktop"
  browser      String?
  ipAddress    String?
  duration     Int?     // time spent on this step in seconds
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([eventType])
  @@index([funnel, funnelStep])
  @@index([createdAt])
  @@index([funnel, stepName])
}

// ─── GDPR Consent & Data Retention ──────────────────────────────────────────

model GdprConsent {
  id          String   @id @default(cuid())
  userId      String?
  email       String   // for guest users who haven't created an account
  consentType String   // "marketing", "analytics", "essential", "data_processing"
  granted     Boolean
  ipAddress   String?
  userAgent   String?
  version     String   @default("1.0") // consent policy version
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@index([email])
  @@index([consentType])
  @@index([createdAt])
}

model DataRetentionLog {
  id           String   @id @default(cuid())
  entityType   String   // "User", "Booking", "Message", "AnalyticsEvent"
  entityId     String
  action       String   // "ANONYMISED", "DELETED", "EXPORTED", "RETENTION_EXTENDED"
  reason       String   // "user_request", "retention_policy", "legal_hold"
  performedBy  String?  // admin userId or "SYSTEM"
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  email       String
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  reason      String?   @db.Text
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  processedBy String?   // admin userId
  notes       String?   @db.Text

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
}

// ─── Secure Document Storage ────────────────────────────────────────────────

model DocumentUpload {
  id              String   @id @default(cuid())
  userId          String
  profileId       String?  // CleanerProfile id if relevant
  documentType    String   // "dbs_certificate", "right_to_work", "photo_id", "insurance"
  originalName    String
  storagePath     String   // encrypted file path in storage
  mimeType        String
  fileSize        Int      // bytes
  encryptionKeyId String   // reference to encryption key used
  checksum        String   // SHA-256 hash of original file for integrity verification
  isVerified      Boolean  @default(false)
  verifiedBy      String?  // admin userId
  verifiedAt      DateTime?
  isDestroyed     Boolean  @default(false)
  destroyedAt     DateTime?
  destroyedReason String?  // "retention_policy", "user_request", "admin_action"
  expiresAt       DateTime? // when the document itself expires (e.g. visa expiry)
  metadata        Json?    // flexible extra data (cert number, issue date, etc.)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([profileId])
  @@index([documentType])
  @@index([isDestroyed])
  @@index([expiresAt])
}

// ─── Data Processing Agreements ─────────────────────────────────────────────

model DpaAgreement {
  id                String    @id @default(cuid())
  processorName     String    // e.g. "Ryft", "Resend", "Railway"
  processorType     String    // "payment_processor", "email_provider", "hosting", "analytics"
  dataCategories    String[]  // what data is processed
  legalBasis        String    // "contract", "consent", "legitimate_interest"
  agreementDate     DateTime?
  expiryDate        DateTime?
  documentRef       String?   // reference to signed agreement
  contactEmail      String?
  status            String    @default("PENDING") // PENDING, ACTIVE, EXPIRED, TERMINATED
  reviewDate        DateTime? // next review date
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([reviewDate])
}

// ─── Data Breach Incident Log ───────────────────────────────────────────────

model BreachIncident {
  id                  String    @id @default(cuid())
  title               String
  description         String    @db.Text
  severity            String    // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  dataTypesAffected   String[]  // e.g. ["personal_data", "financial_data", "identity_documents"]
  individualsAffected Int       @default(0)
  detectedAt          DateTime
  reportedToIcoAt     DateTime? // must be within 72 hours if required
  icoNotificationRef  String?
  containedAt         DateTime?
  resolvedAt          DateTime?
  rootCause           String?   @db.Text
  remedialActions     String?   @db.Text
  lessonsLearned      String?   @db.Text
  reportedBy          String    // userId
  status              String    @default("DETECTED") // DETECTED, CONTAINED, REPORTED_TO_ICO, RESOLVED
  isNotifiable        Boolean   @default(false) // whether it meets ICO notification threshold
  affectedUsers       Json?     // list of affected user IDs (encrypted)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([detectedAt])
}

// ─── ICO Registration ───────────────────────────────────────────────────────

model IcoRegistration {
  id                  String    @id @default(cuid())
  registrationNumber  String?   // ICO registration reference
  registeredName      String    // company name on registration
  registrationDate    DateTime?
  renewalDate         DateTime?
  feeAmount           Decimal?  @db.Decimal(10, 2)
  status              String    @default("PENDING") // PENDING, ACTIVE, RENEWAL_DUE, EXPIRED
  dpoName             String?   // Data Protection Officer
  dpoEmail            String?
  dpoPhone            String?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Push Notification Subscriptions ────────────────────────────────────────

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  subscription String   @db.Text // JSON stringified PushSubscription
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
