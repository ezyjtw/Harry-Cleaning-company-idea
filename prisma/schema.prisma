  @@unique([serviceTypeId, propertySize])
}

model ServiceAddon {
  id            String      @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  name          String
  price         Float
  isActive      Boolean     @default(true)

  bookingAddons BookingAddon[]
}

model PlatformConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// F-A: out-of-area interest capture (quote widget + service pages). Before this
// model existed the /api/waitlist route only console-logged entries — they
// lived nowhere but Railway logs.
// H65 (James ruling a): the promotional-offers tick persists DURABLY — the
// endpoint only fires when ticked, so every row is a consented capture. The
// immutable consent record is the email-keyed GdprConsent row written
// alongside; if the email has an account, the live NotificationPreference
// ledger (which the email chokepoint enforces) is granted too.
model Lead {
  id                 String   @id @default(cuid())
  email              String
  postcode           String
  bedrooms           Int?
  bathrooms          Int?
  serviceType        String?
  estimatedTotal     Decimal? @db.Decimal(10, 2)
  marketingConsentAt DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([email, postcode])
  @@index([email])
  @@index([createdAt])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String
  postcode  String
  source    String // capture point, e.g. "quote-widget" | "service-page"
  createdAt DateTime @default(now())

  @@unique([email, postcode])
  @@index([createdAt])
}

model BookingAddon {
  id        String       @id @default(cuid())
  bookingId String
  booking   Booking      @relation(fields: [bookingId], references: [id])
  addonId   String
  addon     ServiceAddon @relation(fields: [addonId], references: [id])
  price     Float // snapshot price at time of booking

  @@unique([bookingId, addonId])
}

// ─── Top 3 Cleaner Queue ────────────────────────────────────────────────────

model BookingCleanerQueue {
  id           String             @id @default(cuid())
