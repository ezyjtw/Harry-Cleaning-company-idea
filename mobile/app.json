{
  "expo": {
    "name": "Rena Pro",
    "slug": "rena-pro",
    "owner": "harryw84",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "renapro",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b62e3a93-8175-42dd-b1b9-dc7d657856d0"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EBEBEB"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.renacleaning.pro",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Rena Pro uses Face ID to keep your account and jobs secure.",
        "NSCameraUsageDescription": "Rena Pro uses the camera to take your profile and job photos.",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "uk.co.renacleaning.pro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFBFC"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#16296b"
        }
      ]
    ],
    "extra": {
      "baseUrl": "https://www.renacleaning.co.uk",
      "eas": {
        "projectId": "b62e3a93-8175-42dd-b1b9-dc7d657856d0"
      }
    }
  }
}
