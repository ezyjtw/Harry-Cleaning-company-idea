# Database (Railway PostgreSQL)
# Get your connection string from Railway dashboard → PostgreSQL service → Variables → DATABASE_URL
# Format: postgresql://postgres:<password>@<host>.railway.app:5432/railway
DATABASE_URL="postgresql://postgres:your-password@your-host.railway.app:5432/railway"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Ryft
RYFT_PUBLIC_KEY="..."
RYFT_SECRET_KEY="..."
RYFT_WEBHOOK_SECRET="..."

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@rena.com"

# Sentry
SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Rena Cleaning Network"
