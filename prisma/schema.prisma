// ─── Imported Reviews ───────────────────────────────────────────────────────

model ImportedReview {
  id                 String               @id @default(cuid())
  cleanerId          String
  rating             Decimal              @db.Decimal(2, 1) // 1.0 - 5.0, overall only
  text               String?              @db.Text
  source             String               // e.g. "Google", "Checkatrade", "Personal Reference"
  reviewerName       String?
  evidenceUrl        String?              // R2 object key for encrypted screenshot/evidence
  referenceContacts  String?              @db.Text // contact info for admin to verify personal references
  verificationStatus ImportedReviewStatus @default(PENDING)
  adminNotes         String?              @db.Text
  verifiedAt         DateTime?
  verifiedBy         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  cleaner User @relation("ImportedReviews", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([verificationStatus])
}

// ─── Stripe Webhook Idempotency ──────────────────────────────────────────────

model StripeWebhookEvent {
  id          String   @id
  type        String
  payload     Json
  // M4 two-phase: the row is written on RECEIPT (processed=false); handlers run;
  // processed flips true only after ALL side-effects complete. A Stripe retry
  // re-runs any received-but-unprocessed event instead of short-circuiting.
  // (processedAt is historic naming — it records receipt time.)
  processed   Boolean  @default(false)
  processedAt DateTime @default(now())
}

// A13-Xero: the single connection to James's Xero organisation. OAuth tokens are
// ENCRYPTED at rest (AES-256-GCM via document-encryption, keyed by `keyId`) — the
// plaintext access/refresh tokens never touch the DB or the client. Singleton:
// enforced by the unique `key` (always "primary"); a reconnect upserts the row.
model XeroConnection {
  id              String   @id @default(cuid())
  key             String   @unique @default("primary") // singleton guard
  tenantId        String // Xero organisation (tenant) id
  tenantName      String? // org name, for display in admin
  accessTokenEnc  String   @db.Text // encrypted access token (base64)
  refreshTokenEnc String   @db.Text // encrypted refresh token (base64)
  expiresAt       DateTime // access-token expiry (drives refresh)
  keyId           String // document-encryption key id used for these tokens
  connectedByUserId String?

  // A13-Xero-b: account mappings from James's own chart of accounts — never
  // invented. commission/fee/clearing store the Xero account CODE (used as
  // line-item accountCode by chunk-c bank transactions) and are REQUIRED.
  // Gross+clearing model:
  //   bankAccountCode      — the BANK account the customer payment lands in
  //                          (receive money). BANK accounts have NO code, so this
  //                          holds the Xero AccountID. OPTIONAL to save.
  //   commissionAccountCode— Rena's commission → INCOME
  //   feeAccountCode       — the 6% platform fee → INCOME
  //   clearingAccountCode  — cleaner's net held on their behalf → LIABILITY/clearing
  bankAccountCode       String?
  commissionAccountCode String?
  feeAccountCode        String?
  clearingAccountCode   String?
  // A13-Xero reconciliation:
  //   stripeFeeAccountCode      — Stripe's processing fee → EXPENSE (account CODE).
  //                               Booked as a negative line on PAYMENT_RECEIVED so
  //                               the receive nets to what Stripe actually credited.
  //   settlementBankAccountCode — the REAL bank Stripe pays out to (a BANK account,
  //                               so this holds the Xero AccountID). payout.paid is
  //                               booked as a bank transfer FROM the Stripe-balance
  //                               account TO this one.
  stripeFeeAccountCode      String?
  settlementBankAccountCode String?

  // A13-Xero-b: feature flag. Pushes stay OFF until connected + mapped + enabled.
  pushEnabled Boolean @default(false)

  // A13-Xero-c: cached Xero ContactID of the single "Rena Marketplace" platform
  // contact every bank transaction is attached to (Xero requires a Contact).
  // Found-or-created on first push, then reused. Cleared on disconnect with the row.
  platformContactId String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// A13-Xero-c: idempotency ledger for bank-transaction pushes. One row per
// (booking, event, externalRef) — a COMPLETED row means "already pushed, skip".
// externalRef discriminates multiple pushes of the same event: it holds the
// Stripe refund id for REFUND (each RefundRecord is its own reversal) and is ""
// (empty, NOT null) for PAYMENT_RECEIVED / PAYOUT so the unique constraint
// actually catches duplicates — Postgres treats NULLs as distinct, which would
// otherwise let two identical payment pushes both insert.
model XeroPushLog {
  id          String   @id @default(cuid())
  bookingId   String // for STRIPE_PAYOUT this holds the Stripe payout id
  event       String // PAYMENT_RECEIVED | PAYOUT | REFUND | STRIPE_PAYOUT
  externalRef String   @default("") // stripeRefundId for REFUND; "" otherwise
  xeroId      String? // returned Xero BankTransactionID(s)/BankTransferID, comma-joined
  status      String   @default("PENDING") // PENDING | COMPLETED | FAILED
  lastError   String?  @db.Text
  // STRIPE_PAYOUT: JSON summary of the balance-transaction bundle the deposit
  // settles (payout id + constituent transaction ids) — the audit trail tying a
  // bank deposit to the individual charges/refunds/transfers it bundles.
  detail         String?  @db.Text
  // Stamped from the runtime Stripe key at push time (always true — pushes are
  // hard-blocked in test mode — but recorded so a stray test entry is auditable).
  stripeLivemode Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bookingId, event, externalRef])
  @@index([bookingId])
  @@index([status])
}
