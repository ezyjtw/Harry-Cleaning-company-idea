generator client {
  provider        = "prisma-client-js"
  // omitApi: lets the client GLOBALLY exclude heavy/server-only columns
  // (catchmentPolygon) from every query unless explicitly re-enabled.
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  CLEANER
  ADMIN
}

enum CleanerTier {
  STARTER
  BRONZE
  SILVER
  GOLD
  ELITE
}

enum BookingStatus {
  PENDING
  AWAITING_CLEANER
  CONFIRMED
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  REVIEWED
  CANCELLED
  DISPUTED
  CASCADE_EXHAUSTED
  // M3 rescue: a paid booking whose cleaner cancelled — held awaiting the
  // customer's choice (full refund / rebook) until rescueDeadline, then
  // auto-refunded by the scheduler sweep. Excluded from every cleaner-facing
  // job/availability query (the slot frees immediately).
  CLEANER_CANCELLED
}

enum CascadePhase {
  PRIMARY_OFFER
  BACKUP_OFFER
  COMBINED_OFFER
  CASCADE_EXHAUSTED
  PROVISIONAL_APPROVAL
  PHASE2_RESERVE
  RENA_FIND
  RENA_FIND_ADMIN_REVIEW
}

enum PricingModel {
  HOURLY
  FIXED
}

enum PropertySize {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  FOUR_BED
  FIVE_PLUS
}

enum BookingFrequency {
  WEEKLY
  FORTNIGHTLY
  ONE_OFF
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CleanerQueueStatus {
  PENDING // Waiting for cleaner response
  ACCEPTED // Cleaner accepted the job
  REJECTED // Cleaner declined
  EXPIRED // Timed out without response
  SUPERSEDED // Another cleaner accepted first
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_SENT
  NEW_MESSAGE
  NEW_REVIEW
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  ACCOUNT_UPDATE
  SYSTEM
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ReviewVisibility {
  VISIBLE
  HIDDEN
  FLAGGED
}

enum ImportedReviewStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProviderType {
  INDIVIDUAL
  COMPANY
}

enum CompanyVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum TeamMemberRole {
  OWNER
  MANAGER
  CLEANER
}

enum ComplaintCategory {
  NO_SHOW
  POOR_QUALITY
  PROPERTY_DAMAGE
  INCORRECT_DURATION
  SAFETY_CONCERN
  PAYMENT_ISSUE
  UNPROFESSIONAL
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvidenceType {
  PHOTO
  VIDEO
  TEXT
  DOCUMENT
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String?
  name             String?
  phone            String?
  role             Role          @default(CLIENT)
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  accountStatus    AccountStatus @default(ACTIVE)
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?
  failedLoginCount Int           @default(0)
  // F6: bumped on every password change — sessions/tokens issued before this
  // moment are invalidated (checked in getSessionUser / verifyBearerToken).
  passwordChangedAt DateTime?
  isSuspended      Boolean       @default(false)
  lockedUntil      DateTime?

  // Stripe
  stripeCustomerId String?       @unique

  accounts            Account[]
  sessions            Session[]
  cleanerProfile      CleanerProfile?
  addresses           Address[]
  bookingsAsClient    Booking[]             @relation("ClientBookings")
  bookingsAsCleaner   Booking[]             @relation("CleanerBookings")
  reviewsGiven        Review[]              @relation("ReviewsGiven")
  reviewsReceived     Review[]              @relation("ReviewsReceived")
  sentMessages        Message[]             @relation("SentMessages")
  receivedMessages    Message[]             @relation("ReceivedMessages")
  blocksMade          UserBlock[]           @relation("BlocksMade")
  blocksReceived      UserBlock[]           @relation("BlocksReceived")
  reportsFiled        MessageReport[]       @relation("ReportsFiled")
  reportsAgainst      MessageReport[]       @relation("ReportsAgainst")
  notifications       Notification[]
  disputesRaised      Dispute[]             @relation("DisputesRaised")
  ownedCompany        Company?              @relation("CompanyOwner")
  teamMemberships     TeamMember[]
  complaints          Complaint[]           @relation("ComplaintsFiled")
  cleanerQueueEntries BookingCleanerQueue[] @relation("CleanerQueueEntries")
  pushSubscriptions   PushSubscription[]
  deviceTokens        DeviceToken[]
  importedReviews     ImportedReview[]      @relation("ImportedReviews")
  notificationPreference NotificationPreference?

  @@index([email])
  @@index([role])
}

model CleanerProfile {
  id                    String      @id @default(cuid())
  userId                String      @unique
  bio                   String?     @db.Text
  specialties           String[]
  languages             String[]
  serviceTypes          String[]

  // Per-service hourly rates (null = doesn't offer this service)
  hourlyRateRegular     Decimal?    @db.Decimal(10, 2)
  hourlyRateDeep        Decimal?    @db.Decimal(10, 2)
  hourlyRateSameDay     Decimal?    @db.Decimal(10, 2) // @deprecated — same-day feature disabled; kept for future re-enable

  // Fixed-price services — JSON with property-size keys
  eotPrices             Json?
  airbnbPrices          Json?
  hoursPerWeek          Int?
  yearsExperience       Int?
  tier                  CleanerTier @default(STARTER)
  verified              Boolean     @default(false)
  documentsUploaded     Boolean     @default(false)
  backgroundCheckPassed Boolean     @default(false)

  // DBS certificate — destroyed after verification, only metadata retained
  dbsCertVerified     Boolean            @default(false)
  dbsCertNumber       String? // retained after destruction
  dbsCertIssueDate    DateTime? // retained after destruction
  dbsCertDestroyedAt  DateTime? // when the actual file was destroyed
  // DEPRECATED: dual-written from homePostcode for backward compatibility with matching service.
  // Future PR will migrate matching to homeLatitude/homeLongitude/maxTravelMinutes
  // and drop these legacy fields. Do not write to these directly — set home* fields instead.
  location            String?
  latitude            Float?
  longitude           Float?
  radius              Int                @default(10)
  travelMode          String             @default("public_transport")
  availableNow        Boolean            @default(false)
  responseTime        Int? // average response time in minutes
  completedJobs       Int                @default(0)
  rating              Decimal            @default(0) @db.Decimal(3, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  serviceRadius       Int                @default(10) // @deprecated — replaced by maxTravelMinutes; kept for rollback
  travelFee           Decimal            @default(0) @db.Decimal(10, 2)
  cancellationRate    Decimal            @default(0) @db.Decimal(5, 2)
  completionRate      Decimal            @default(100) @db.Decimal(5, 2)
  responseSpeed       Int? // average response speed in seconds
  // DEPRECATED: dual-written from homePostcode. See location/latitude/longitude deprecation above.
  postcode            String?
  ryftAccountId       String?

  // Stripe Connect
  stripeAccountId       String?   @unique
  stripeChargesEnabled  Boolean   @default(false)
  stripePayoutsEnabled  Boolean   @default(false)
  stripeOnboardedAt     DateTime?

  verificationStatus  VerificationStatus @default(UNVERIFIED)
  identityVerifiedAt  DateTime?
  verificationMeta    Json?
  totalJobsCompleted  Int                @default(0)
  availabilitySummary String?            @db.Text

  // Insurance verification
  insuranceVerified   Boolean   @default(false)
  insuranceExpiresAt  DateTime?
  insuranceVerifiedAt DateTime?

  // Right to work verification
  rightToWorkStatus     VerificationStatus @default(UNVERIFIED)
  rightToWorkDocType    String? // "uk_passport", "brp", "eu_settled", "eu_pre_settled", "share_code", "visa"
  rightToWorkDocFile    String? // stored file reference
  rightToWorkShareCode  String? // gov.uk share code if applicable
  rightToWorkExpiresAt  DateTime? // null for indefinite right (UK/Irish citizens)
  rightToWorkVerifiedAt DateTime?

  testimonials Json?

  // A14: self-employment acknowledgment — denormalized CURRENT acknowledged
  // version, used by the onboarding + job-eligibility gates. Set when the cleaner
  // accepts; when the current version bumps (v1→v2) this no longer matches the
  // current version → re-acknowledge required. The append-only AgreementAcceptance
  // rows are the full audit trail (who/when/IP/text hash).
  acknowledgmentVersion String?

  // Booking buffer & travel-time matching
  bookingBufferMinutes Int       @default(30)
  homePostcode         String?
  homeLatitude         Float?
  homeLongitude        Float?
  homeGeocodedAt       DateTime?
  maxTravelMinutes     Int?

  // B (travel-time catchment): real road-network isochrone stored as raw
  // GeoJSON exactly as the provider returned it (provider-swappable by
  // construction — catchmentSource names the generator, e.g.
  // 'ors-isochrone-v1'). Nullable: absent ⇒ the predicate falls back to the
  // crow-flies travel-time logic. The hot path NEVER calls a provider.
  catchmentPolygon     Json?
  catchmentGeneratedAt DateTime?
  catchmentSource      String?

  // Two-stage verification (James-ruled): identity verification (verified) and
  // go-live (insurance approved + Stripe complete) are distinct moments. The
  // "you're live" email sends exactly once — stamped here by maybeMarkLive().
  liveNotifiedAt       DateTime?

  // F-B: permanent founding badge for the first N cleaners to go live
  // (auto-set by maybeMarkLive while under the founding_cleaner_limit
  // PlatformConfig; admin-togglable per cleaner). Never expires.
  foundingCleaner      Boolean            @default(false)

  providerId String?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              Provider?              @relation(fields: [providerId], references: [id])
  availabilitySlots     AvailabilitySlot[]
  availabilityOverrides AvailabilityOverride[]
  availabilityDateSlots AvailabilityDateSlot[]
  rateModifiers         RateModifier[]

  @@index([userId])
  @@index([tier])
  @@index([verified])
  @@index([availableNow])
  @@index([location])
  @@index([rating])
  @@index([providerId])
}

model RateModifier {
  id               String   @id @default(cuid())
  cleanerProfileId String
  date             DateTime @db.Date
  modifierPercent  Int
  reason           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cleanerProfile CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@unique([cleanerProfileId, date])
  @@index([cleanerProfileId])
  @@index([date])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String? // e.g. "Home", "Office"
  line1     String
  line2     String?
  city      String
  postcode  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@index([postcode])
}

model Booking {
  id                 String        @id @default(cuid())
  clientId           String?
  cleanerId          String
  addressId          String?
  // A12: structured address captured at booking time, stored directly on the
  // booking (Option A). This is the SINGLE SOURCE OF TRUTH for "where the clean
  // happens" — works uniformly for guests AND registered users (no Address-model
  // ownership question). The legacy `addressId`/`address` relation is kept for
  // back-compat but reads should use these columns. Populated from the
  // getAddress.io autocomplete selection (or a copied saved address).
  addressLine1       String?
  addressLine2       String?
  addressCity        String?
  addressPostcode    String?
  guestEmail         String?
  guestName          String?
  guestPhone         String?
  guestToken         String?       @unique
  serviceType        String // e.g. "standard", "deep", "end-of-tenancy", "move-in"
  status             BookingStatus @default(PENDING)
  date               DateTime
  startTime          String // e.g. "09:00"
  duration           Decimal       @db.Decimal(4, 2) // hours
  rooms              Json? // { "bedrooms": 2, "bathrooms": 1, "kitchen": true, ... }
  extras             String[] // e.g. ["oven", "fridge", "windows"]
  frequency          String? // e.g. "one-off", "weekly", "fortnightly", "monthly"
  totalPrice         Decimal       @db.Decimal(10, 2)
  platformFee        Decimal       @db.Decimal(10, 2)
  cleanerEarnings    Decimal       @db.Decimal(10, 2)
  notes              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  acceptedAt         DateTime?
  checkedInAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text
  // M3 rescue flow (cleaner-cancel): the choice deadline (min(cancel+48h, start))
  // and a PERSISTENT stamp of who cancelled — survives rebooking (when cleanerId
  // is replaced) so reliability stats count every cleaner cancellation.
  rescueDeadline       DateTime?
  cancelledByCleanerId String?
  cleanerNotes       String?       @db.Text
  adminNotes         String?       @db.Text
  checklistCompleted Boolean       @default(false)
  arrivalConfirmed   Boolean       @default(false)

  providerId String?

  client        User?                 @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  cleaner       User                  @relation("CleanerBookings", fields: [cleanerId], references: [id], onDelete: Cascade)
  address       Address?              @relation(fields: [addressId], references: [id])
  provider      Provider?             @relation(fields: [providerId], references: [id])
  review        Review?
  messages      Message[]
  payment       Payment?
  dispute       Dispute?
  complaints    Complaint[]
  bookingAddons BookingAddon[]
  cleanerQueue  BookingCleanerQueue[]
  refundRecords RefundRecord[]

  // ─── Pricing snapshot (captured at booking creation) ─────
  propertySize              PropertySize?
  bookingFrequency          BookingFrequency?
  cleanerPayoutAmount       Decimal?  @db.Decimal(10, 2)
  platformCommissionAmount  Decimal?  @db.Decimal(10, 2)
  platformFeeAmount         Decimal?  @db.Decimal(10, 2)
  totalAmountCharged        Decimal?  @db.Decimal(10, 2)
  customerSubtotal          Float?
  customerServiceFee        Float?
  renaEarns                 Float?

  // ─── Stripe Payment ─────
  stripePaymentIntentId  String?        @unique
  stripeChargeId         String?        @unique
  paymentStatus          PaymentStatus  @default(PENDING)

  // A16b-1: client-supplied idempotency key for booking+payment creation. A
  // double-click / retry replays the same booking + PaymentIntent instead of
  // creating duplicates. Unique so concurrent submits collide at the DB layer.
  idempotencyKey         String?        @unique

  // ─── Transfer / fund release ─────
  stripeTransferId       String?        @unique
  transferStatus         String         @default("PENDING")
  transferAttempt        Int            @default(0)
  transferFailureReason  String?
  releaseDueAt           DateTime?
  completionConfirmedAt  DateTime?

  // ─── Backup cleaners ─────
  // Ordered list of backup cleaner User.ids (same id type as cleanerId).
  // If the primary cleaner declines, cascade logic (A5) can activate the next backup.
  backupCleanerIds   String[]
  // Customer delegates backup selection to Rena ("Provide me an appropriate cleaner" toggle)
  autoAssignBackup   Boolean @default(false)

  // ─── Cascade offer tracking (A5.1) ─────
  cascadePhase            CascadePhase?
  cascadeExpiresAt        DateTime?
  cascadeBackupExpiresAt  DateTime?
  declinedCleanerIds      String[]     @default([])
  // B3: one entry per decline — [{ cleanerId, reason, at }]. Reasons come from
  // the shell's decline sheet (too_far | bad_time | pay_too_low | other) and
  // feed future cascade analytics. Additive, nullable.
  declineReasons          Json?

  // ─── Price reconciliation (A5.3) ─────
  provisionalCleanerId   String?
  provisionalPrice       Decimal?  @db.Decimal(10, 2)
  topupAmount            Decimal?  @db.Decimal(10, 2)
  approvalExpiresAt      DateTime?
  topupApproved          Boolean   @default(false)
  topupRecords           TopupRecord[]

  // ─── Phase 2 reserves (A5.3 Stage 2) ─────
  reserveCleanerIds      String[]  @default([])
  phase2Entered          Boolean   @default(false)

  // ─── Admin reassign / provisional source + revert state (A5.3 Stage 3) ─────
  provisionalSource          String?         // 'CASCADE' | 'ADMIN_REASSIGN' — discriminates decline/expiry routing
  reassignPreviousStatus     BookingStatus?  // restored by revertAdminReassign on customer decline
  reassignPreviousCleanerId  String?         // explicit revert anchor (not relying on cleanerId-untouched invariant)

  // ─── Top 3 Queue & Escrow ─────
  isQueuedBooking    Boolean @default(false)
  acceptedFromQueue  Boolean @default(false)

  @@index([clientId])
  @@index([cleanerId])
  @@index([status])
  @@index([date])
  @@index([createdAt])
  @@index([guestEmail]) // A16b-2b: guest→account claim lookup
  @@index([cleanerId, date])
  @@index([providerId])
  @@index([guestToken])
  @@index([status, cascadePhase])
}

model Review {
  id                String           @id @default(cuid())
  bookingId         String           @unique
  clientId          String
  cleanerId         String
  rating            Decimal          @db.Decimal(2, 1) // 1.0 - 5.0
  thoroughness      Decimal?         @db.Decimal(2, 1)
  punctuality       Decimal?         @db.Decimal(2, 1)
  communication     Decimal?         @db.Decimal(2, 1)
  text              String?          @db.Text
  reply             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isModerated       Boolean          @default(false)
  visibility        ReviewVisibility @default(VISIBLE)
  isVerifiedBooking Boolean          @default(true)
  isDisputed        Boolean          @default(false)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client  User    @relation("ReviewsGiven", fields: [clientId], references: [id], onDelete: Cascade)
  cleaner User    @relation("ReviewsReceived", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([cleanerId])
  @@index([rating])
  @@index([visibility])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  // A10 B1: every message is tagged with the booking it relates to (REQUIRED).
  // Conversations are still grouped by the client<->cleaner PAIR (full history
  // across all their bookings); bookingId gives per-message booking context and
  // drives the release-gated send window. (Migration truncates Message — see PR.)
  bookingId  String
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User            @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User            @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reports  MessageReport[]

  @@index([senderId])
  @@index([receiverId])
  @@index([bookingId])
  @@index([createdAt])
}

// A10 B2: directional user block. If a block exists in EITHER direction between
// two users, neither can message the other — enforced in the gated sendMessage,
// overriding an active booking. Additive table; non-destructive migration.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// A10 B2b: user-filed report of a message for moderation. Distinct from Complaint
// (which is booking/financial) — captures the offending message, who reported it,
// who is reported, and a reason, for an admin queue. Additive; non-destructive.
enum MessageReportReason {
  SPAM
  HARASSMENT
  OFF_PLATFORM
  INAPPROPRIATE
  OTHER
}

enum MessageReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// A10 B3: USER = a person reported the message; SYSTEM = auto-flagged (e.g.
// suspected off-platform contact info). SYSTEM flags have no human reporter.
enum MessageReportOrigin {
  USER
  SYSTEM
}

model MessageReport {
  id             String              @id @default(cuid())
  messageId      String
  // Nullable: SYSTEM-origin (auto-flagged) reports have no human reporter.
  reporterId     String?
  reportedUserId String
  bookingId      String
  origin         MessageReportOrigin @default(USER)
  reason         MessageReportReason
  details        String?             @db.Text
  status         MessageReportStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  adminNotes     String?             @db.Text
  createdAt      DateTime            @default(now())

  message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter     User?   @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User    @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reportedUserId])
  @@index([messageId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// A11: per-user notification preferences (the LIVE source of truth for what a
// user wants delivered). Category-based, not per-NotificationType, to keep the
// matrix small. Essential transactional messages (booking/payment confirms,
// receipts, account/security) are NOT represented here — they can never be
// disabled, so shouldSend() bypasses this row for them entirely.
//
// Defaults encode the A11 policy: toggleable categories default ON; marketing is
// strictly OPT-IN (default OFF). Existing users have no row → getPreferences()
// falls back to these same defaults, so the additive migration is safe with no
// backfill.
//
// GdprConsent remains the append-only AUDIT log of consent events; this row is
// the current state. marketingConsentAt / unsubscribedAt / version carry the
// PECR/GDPR evidence on the live record.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  // Toggleable categories (default ON).
  reminders  Boolean @default(true) // booking reminders + review requests
  newMessage Boolean @default(true) // new-message alerts

  // Channel master switches (default ON). Gate PUSH / SMS across all
  // non-essential categories. Email has no master — it is gated per-category.
  push Boolean @default(true)
  sms  Boolean @default(true)

  // Marketing: strictly opt-in (default OFF). marketingConsentAt records when
  // consent was granted; unsubscribedAt records a withdrawal (PECR evidence).
  marketing          Boolean   @default(false)
  marketingConsentAt DateTime?
  unsubscribedAt     DateTime?

  version   String   @default("1.0")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  ryftPaymentId   String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  refundAmount    Decimal?      @db.Decimal(10, 2)
  discountPercent Int?
  discountAmount  Decimal?      @db.Decimal(10, 2)
  promoCode       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([ryftPaymentId])
}

model RefundRecord {
  id             String   @id @default(cuid())
  bookingId      String
  stripeRefundId String?  @unique
  amount         Decimal  @db.Decimal(10, 2)
  reason         String
  triggeredBy    String?
  status         String   @default("PENDING")
  attempt        Int      @default(0)
  failureReason  String?
  // M5: which Stripe charge(s) this refund actually hit — LIFO allocation slices
  // [{ pi, refundId, amountPence }]. Null on records predating top-up-aware
  // refunds (those were all against the original PI).
  allocation     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model TopupRecord {
  id                    String   @id @default(cuid())
  bookingId             String
  stripePaymentIntentId String?  @unique
  amount                Decimal  @db.Decimal(10, 2)
  reason                String
  status                String   @default("PENDING")
  paymentMethodType     String?
  attempt               Int      @default(0)
  failureReason         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  maxUses         Int?
  usedCount       Int       @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@index([code])
}

model Dispute {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  // H41 guest parity: null when a GUEST (tokened, no account) filed the
  // dispute — the booking's guestName/guestEmail identify them.
  raisedById  String?
  reason      String
  description String        @db.Text
  status      DisputeStatus @default(OPEN)
  resolution  String?       @db.Text
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime      @updatedAt

  booking  Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy User?             @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  evidence DisputeEvidence[]

  @@index([bookingId])
  @@index([raisedById])
  @@index([status])
}

model AvailabilitySlot {
  id               String @id @default(cuid())
  cleanerProfileId String
  dayOfWeek        Int // 0 = Sunday, 6 = Saturday
  startTime        String // e.g. "09:00"
  endTime          String // e.g. "17:00"

  cleanerProfile CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@index([cleanerProfileId])
  @@index([dayOfWeek])
}

model AvailabilityOverride {
  id               String   @id @default(cuid())
  cleanerProfileId String
  date             DateTime @db.Date
  isBlocked        Boolean  @default(true)
  startTime        String? // if partial day, e.g. "09:00"
  endTime          String? // if partial day, e.g. "13:00"
  reason           String? // e.g. "Holiday", "Personal"
  createdAt        DateTime @default(now())

  cleanerProfile CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@unique([cleanerProfileId, date])
  @@index([cleanerProfileId])
  @@index([date])
}

model AvailabilityDateSlot {
  id               String         @id @default(cuid())
  cleanerProfileId String
  date             DateTime       @db.Date
  startTime        String // "HH:MM"
  endTime          String // "HH:MM"
  createdAt        DateTime       @default(now())

  cleanerProfile CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  @@unique([cleanerProfileId, date, startTime])
  @@index([cleanerProfileId])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g. "BOOKING_CREATED", "PAYMENT_PROCESSED"
  entityType String // e.g. "Booking", "Payment", "User"
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model PricingRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  multiplier  Decimal   @default(1.0) @db.Decimal(5, 2)
  isActive    Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model PricingZone {
  id             String  @id @default(cuid())
  name           String // e.g. "Central London", "Greater London"
  postcodePrefix String  @unique // e.g. "SW1", "E1"
  multiplier     Decimal @default(1.0) @db.Decimal(4, 2)
  travelFee      Decimal @default(0) @db.Decimal(10, 2)
  isActive       Boolean @default(true)

  @@index([postcodePrefix])
