// ─── GDPR Consent & Data Retention ──────────────────────────────────────────

model GdprConsent {
  id          String    @id @default(cuid())
  userId      String?
  email       String // for guest users who haven't created an account
  consentType String // "marketing", "analytics", "essential", "data_processing"
  granted     Boolean
  ipAddress   String?
  userAgent   String?
  version     String    @default("1.0") // consent policy version
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@index([email])
  @@index([consentType])
  @@index([createdAt])
}

// A14: append-only record of a cleaner acknowledging the self-employment terms.
// One row per acceptance event — never updated. `textHash` is the SHA-256 of the
// exact document body the cleaner saw, so we can prove WHICH wording they agreed
// to even if a version's text were ever edited. Current-state lookups use the
// denormalized CleanerProfile.acknowledgmentVersion; this table is the evidence.
model AgreementAcceptance {
  id               String   @id @default(cuid())
  cleanerId        String // User id of the cleaner (matches Booking.cleanerId)
  agreementType    String   @default("self_employment")
  agreementVersion String
  textHash         String // SHA-256 of the acknowledged document body
  ipAddress        String?
  userAgent        String?
  agreedAt         DateTime @default(now())

  @@index([cleanerId])
  @@index([agreementVersion])
}

model DataRetentionLog {
  id          String   @id @default(cuid())
  entityType  String // "User", "Booking", "Message", "AnalyticsEvent"
  entityId    String
  action      String // "ANONYMISED", "DELETED", "EXPORTED", "RETENTION_EXTENDED"
  reason      String // "user_request", "retention_policy", "legal_hold"
  performedBy String? // admin userId or "SYSTEM"
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  email       String
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  reason      String?   @db.Text
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  processedBy String? // admin userId
  notes       String?   @db.Text

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
}

// ─── Secure Document Storage ────────────────────────────────────────────────

model DocumentUpload {
  id              String    @id @default(cuid())
  userId          String
  profileId       String? // CleanerProfile id if relevant
  documentType    String // "dbs_certificate", "right_to_work", "photo_id", "insurance"
  originalName    String
  storagePath     String // encrypted file path in storage
  mimeType        String
  fileSize        Int // bytes
  encryptionKeyId String // reference to encryption key used
  checksum        String // SHA-256 hash of original file for integrity verification
  isVerified      Boolean   @default(false)
  verifiedBy      String? // admin userId
  verifiedAt      DateTime?
  // Admin reject (James, live testing): a rejected doc must be distinct from a
  // never-reviewed one — else the queue chip can't change and the cleaner never
  // learns why. Nullable; set when an admin rejects, cleared on re-upload.
  rejectedAt      DateTime?
  rejectionReason String?
  isDestroyed     Boolean   @default(false)
  destroyedAt     DateTime?
  destroyedReason String? // "retention_policy", "user_request", "admin_action"
  expiresAt       DateTime? // when the document itself expires (e.g. visa expiry)
  metadata        Json? // flexible extra data (cert number, issue date, etc.)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([profileId])
  @@index([documentType])
  @@index([isDestroyed])
  @@index([expiresAt])
}

// ─── Data Processing Agreements ─────────────────────────────────────────────

model DpaAgreement {
  id             String    @id @default(cuid())
  processorName  String // e.g. "Ryft", "Resend", "Railway"
  processorType  String // "payment_processor", "email_provider", "hosting", "analytics"
  dataCategories String[] // what data is processed
