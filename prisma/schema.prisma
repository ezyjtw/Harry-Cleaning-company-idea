// ─── Push Notification Subscriptions ────────────────────────────────────────

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  subscription String   @db.Text // JSON stringified PushSubscription
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Native (Rena Pro / Expo) push device tokens — multi-device per user. Parallel
// to PushSubscription (web push); the notification service's EXPO_PUSH channel
// sends to these. Additive model — safe under `prisma db push`.
model DeviceToken {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String // 'ios' | 'android'
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
