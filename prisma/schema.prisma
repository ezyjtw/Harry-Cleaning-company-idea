  quotedTotal  Float // total customer would pay with this cleaner
  cleanerEarns Float // what the cleaner nets after fees
  matchScore   Float // score from matching algorithm
  notifiedAt   DateTime? // when the cleaner was notified
  respondedAt  DateTime? // when they accepted/rejected
  expiresAt    DateTime? // auto-expire deadline
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  cleaner User    @relation("CleanerQueueEntries", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, cleanerId])
  @@index([bookingId])
  @@index([cleanerId])
  @@index([status])
}

// ─── Abandoned Lead Tracking ─────────────────────────────────────────────────

model AbandonedLead {
  id          String    @id @default(cuid())
  email       String
  cleanerId   String?
  postcode    String?
  step        Int       @default(1)
  emailSent   Boolean   @default(false)
  lastEmailAt DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([emailSent])
  @@index([createdAt])
}

// ─── Analytics Event Tracking ───────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String // anonymous session identifier
  userId     String? // null for unauthenticated visitors
  eventType  String // e.g. "FUNNEL_STEP", "PAGE_VIEW", "FORM_INTERACTION", "DROP_OFF"
  funnel     String? // e.g. "booking", "cleaner_signup", "client_signup"
  funnelStep Int? // step number in funnel (1, 2, 3...)
  stepName   String? // e.g. "postcode_entered", "service_selected", "payment_submitted"
  page       String? // URL path
  referrer   String? // where they came from
  metadata   Json? // flexible extra data (form field, error message, time on step, etc.)
  deviceType String? // "mobile", "tablet", "desktop"
  browser    String?
  ipAddress  String?
  duration   Int? // time spent on this step in seconds
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([eventType])
  @@index([funnel, funnelStep])
