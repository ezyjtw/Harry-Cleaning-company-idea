# Database (Railway PostgreSQL)
# Get your connection string from Railway dashboard → PostgreSQL service → Variables → DATABASE_URL
# Format: postgresql://postgres:<password>@<host>.railway.app:5432/railway
DATABASE_URL="postgresql://postgres:your-password@your-host.railway.app:5432/railway"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Stripe Payments
# Get keys from https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY="re_..."

# Groq AI (chatbot)
GROQ_API_KEY="gsk_your-groq-api-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Rena Cleaning Network"
